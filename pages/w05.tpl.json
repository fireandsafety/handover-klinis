{"tl_label": "<label class=\"flex items-start gap-space-md p-space-md rounded-lg bg-surface hover:bg-surface-container-low transition-colors cursor-pointer group\">\n<input checked=\"\" class=\"mt-1 w-5 h-5 rounded text-primary focus:ring-0 cursor-pointer accent-primary shrink-0\" data-tl=\"{{tl_id}}\" id=\"ack-{{tl_id}}\" onchange=\"updateAckStatus()\" type=\"checkbox\"/>\n<div class=\"flex flex-col md:flex-row md:items-center justify-between gap-space-xs flex-1\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-primary font-bold\">{{no}}. {{isi}}</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">{{detail}}</span>\n</div>\n<div class=\"flex items-center gap-space-xs shrink-0 font-data-mono text-body-sm text-on-surface-variant bg-surface-container px-2.5 py-1 rounded\">\n<span class=\"material-symbols-outlined text-[16px] text-secondary\">schedule</span>\n<span>{{acktxt}}</span>\n</div>\n</div>\n</label>", "st_card": "<div class=\"bg-surface-container-lowest rounded-xl shadow-sm p-space-lg flex flex-col gap-space-md relative overflow-hidden\">\n<div class=\"absolute left-0 top-0 bottom-0 w-1.5 bg-primary\"></div>\n<div class=\"flex flex-col lg:flex-row lg:items-center justify-between gap-space-md\">\n<div class=\"flex flex-wrap items-center gap-space-sm\">\n<span class=\"bg-surface-container-high text-primary font-label-lg text-label-lg font-bold px-3 py-1 rounded\">{{bed}}</span>\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold\">{{inisial}}</span>\n<span class=\"font-data-mono text-body-sm text-on-surface-variant bg-surface-container-low px-2 py-0.5 rounded\">MR {{mr}} ({{sex}}/{{umur}}th)</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">DPJP: <strong class=\"text-primary font-semibold\">{{dpjp}}</strong></span>\n</div>\n<div class=\"flex flex-wrap items-center gap-space-xs\">\n<span class=\"bg-error-container text-on-error-container font-label-sm text-label-sm px-2.5 py-0.5 rounded-full font-bold flex items-center gap-1\" data-rep=\"flags\">\n<span class=\"material-symbols-outlined text-[14px]\">personal_injury</span>{{f}}</span>\n\n</div>\n</div>\n\n<div class=\"bg-surface p-space-md rounded-lg flex flex-col md:flex-row gap-space-md\">\n<div class=\"flex-1 flex flex-col gap-1\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-label-sm text-label-sm bg-primary text-on-primary px-1.5 py-0.5 rounded font-bold\">SBAR</span>\n<span class=\"font-label-md text-label-md text-primary font-bold\">Diagnosis: {{dx}}</span>\n</div>\n<p class=\"font-body-md text-body-md text-on-surface\">{{sbar}}</p>\n</div>\n<div class=\"flex md:flex-col justify-between shrink-0 gap-2 font-data-mono text-body-sm bg-surface-container-low p-space-sm rounded min-w-[200px]\">\n\n\n\n</div>\n</div>\n</div>", "st_row": "<tr class=\"hover:bg-surface transition-colors\">\n<td class=\"py-space-md px-space-md font-semibold\">\n<span class=\"bg-surface-container text-primary font-label-sm text-label-sm px-2 py-0.5 rounded font-bold mr-2\">{{bed}}</span>{{inisial}} ({{umur}}th)</td>\n<td class=\"py-space-md px-space-md\">\n<div class=\"font-data-mono text-body-sm text-on-surface-variant\">MR {{mr}}</div>\n<div class=\"font-label-sm text-label-sm text-primary font-bold\">{{dpjp}}</div>\n</td>\n<td class=\"py-space-md px-space-md font-bold text-primary\">{{dx}}</td>\n<td class=\"py-space-md px-space-md text-on-surface-variant font-body-sm\">{{sbar}}</td>\n<td class=\"py-space-md px-space-md font-data-mono text-body-sm\">{{ket}}</td>\n<td class=\"py-space-md px-space-md text-right\">\n<span class=\"bg-surface-container text-primary font-label-sm text-label-sm px-2 py-0.5 rounded font-bold\">{{st}}</span>\n</td>\n</tr>"}